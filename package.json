{
  "name": "lastro-app",
  "version": "2.0.0",
  "private": true,
  "description": "Registro de treino, cardio, nutrição e acompanhamento corporal. Um artefato estático, offline, sem dependência de runtime.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tipos": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:dominio": "vitest run --project dominio",
    "test:fluxo": "npm run build && vitest run --project fluxo",
    "treino": "vite-node tests/gerar-treino.js",
    "volume": "vite-node tests/gerar-volume.js"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^7.1.12",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
